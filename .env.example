# Copy to .env and fill in. Every value here must also be set in the Netlify UI
# (Site settings -> Environment variables) or production will not have it.

# --- Database ---
MONGODB_URI=

# --- Square (payments) ---
# Server-side access token. Booking charges are made with this.
NUXT_ACCESS_TOKEN=
NUXT_PUBLIC_SQUARE_APP_ID=
NUXT_PUBLIC_LOCATION_ID=
# Set to "sandbox" to test checkout against Square's sandbox (loads the sandbox
# Web SDK in the browser and charges the sandbox API). Leave empty for production.
NUXT_PUBLIC_SQUARE_ENVIRONMENT=

# --- Email notifications ---
# Gmail APP PASSWORD (not the account password). Generate at:
# Google Account -> Security -> 2-Step Verification -> App passwords.
# Spaces in the displayed value are stripped automatically.
# IMPORTANT: it must be generated on the SAME account as NUXT_MAIL_USER below —
# a mismatch fails with "535 Username and Password not accepted".
# If this is wrong or missing, bookings still succeed but no email is sent and
# the failure is logged as "[notify] ... email failed".
NUXT_PASS=

# Gmail account used to send. Must match the account NUXT_PASS was created on.
# Defaults to prolinewheelandtire@gmail.com when empty.
NUXT_MAIL_USER=

# Where "New Appointment" notifications go. Defaults to prolinewheelandtire@gmail.com.
NUXT_MAIL_OWNER=

# --- Optional owner push notifications (ntfy.sh) ---
# Leave empty to disable. To enable: pick a hard-to-guess topic name, set it
# here, then install the free ntfy app and subscribe to the same topic.
# Anyone who knows the topic name can read the notifications, so treat it as a secret.
NUXT_NTFY_TOPIC=

# --- Auth ---
NUXT_JWT_SECRET=

# --- Misc ---
NUXT_PUBLIC_TIRE_CONNECT=
CHAT_SERVER_URL=
